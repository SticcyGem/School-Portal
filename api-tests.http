### 1. Login as ADMIN (Required for most setup actions)
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "email": "admin@plm.edu.ph",
  "password": "P@ssw0rd"
}
> {%
    if (response.status === 200) {
        client.global.set("admin_token", response.body.data.token);
        client.log("✅ ADMIN TOKEN ACQUIRED");
    }
%}

### Search by Email (Exact or Partial)
GET http://localhost:8080/api/admin/users/search?q=fresh_student
Authorization: Bearer {{admin_token}}

### Search by First Name
GET http://localhost:8080/api/admin/users/search?q=Fresh
Authorization: Bearer {{admin_token}}

### Search by Student Type (e.g., "IRREGULAR")
GET http://localhost:8080/api/admin/users/search?q=IRREGULAR
Authorization: Bearer {{admin_token}}

### Search by Status (e.g., "ACTIVE")
GET http://localhost:8080/api/admin/users/search?q=ACTIVE
Authorization: Bearer {{admin_token}}

### Search by Year Level (e.g., "2")
GET http://localhost:8080/api/admin/users/search?q=2
Authorization: Bearer {{admin_token}}

### 2a. Register a NEW Irregular Student
POST http://localhost:8080/api/admin/register/student
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "email": "fresh_student_v5@plm.edu.ph",
  "password": "password123",
  "first_name": "Fresh",
  "last_name": "Student",
  "education_level": "UNDERGRADUATE",
  "student_type": "IRREGULAR",
  "course_code": "BSCS",
  "block_no": 2
}

### 2b. Register a NEW Professor
POST http://localhost:8080/api/admin/register/professor
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "email": "professor@plm.edu.ph",
  "password": "password123",
  "first_name": "Proffy",
  "middle_name": "Proof",
  "last_name": "Pwes",
  "employee_type": "FULL_TIME"
}

### 2c. Register "Reject Candidate" Student (For Failure Testing)
POST http://localhost:8080/api/admin/register/student
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "email": "reject_me@plm.edu.ph",
  "password": "password123",
  "first_name": "Reject",
  "last_name": "Candidate",
  "education_level": "UNDERGRADUATE",
  "student_type": "REGULAR",
  "course_code": "BSCS",
  "block_no": 1
}

### 2d. Search for User & Capture ID (For Update Test)
GET http://localhost:8080/api/admin/users/search?q=fresh_student_v8@plm.edu.ph
Authorization: Bearer {{admin_token}}

> {%
    const users = response.body;
    if (users && users.length > 0) {
        const target = users[0];
        client.global.set("target_user_id", target.account_id);
        client.log("✅ TARGET USER ID ACQUIRED: " + target.account_id);
    } else {
        client.log("❌ Could not find user via search API");
    }
%}

### 2e. Update User Details (Admin Action)
PUT http://localhost:8080/api/admin/users/{{target_user_id}}
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "first_name": "Fresher",
  "status": "ACTIVE"
}

### 3a. Create a New Subject
POST http://localhost:8080/api/admin/subjects
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "subject_code": "AI 101",
  "subject_name": "Introduction to Artificial Intelligence",
  "lec_units": 2,
  "lab_units": 1
}

### 3b. Update the Subject
PUT http://localhost:8080/api/admin/subjects/AI%20101
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "subject_name": "Intro to AI & Deep Learning",
  "lec_units": 3,
  "lab_units": 0
}

### 3c. Get All Subjects
GET http://localhost:8080/api/admin/subjects
Authorization: Bearer {{admin_token}}

### 3d. Delete the Subject
DELETE http://localhost:8080/api/admin/subjects/AI%20101
Authorization: Bearer {{admin_token}}

### 3e. Try to Delete a Used Subject (Should FAIL)
DELETE http://localhost:8080/api/admin/subjects/CSC%200212
Authorization: Bearer {{admin_token}}

### 4a. Login as the NEW Student
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "email": "fresh_student_v8@plm.edu.ph",
  "password": "password123"
}
> {%
    if (response.status === 200) {
        client.global.set("student_token", response.body.data.token);
        client.log("✅ STUDENT TOKEN ACQUIRED");
    }
%}

### 4b. GET Enrollment Options
GET http://localhost:8080/api/enrollment/options
Authorization: Bearer {{student_token}}

### 4c. SUBMIT Draft Enrollment
# Note: Ensure section_ids exist in your DB
POST http://localhost:8080/api/enrollment/submit
Content-Type: application/json
Authorization: Bearer {{student_token}}

{
  "section_id": [1, 2, 3]
}

### 4d. APPROVE Enrollment (Admin Action)
# IMPORTANT: Adjust ID '2' if enrollment ID differs
POST http://localhost:8080/api/admin/approve/2
Authorization: Bearer {{admin_token}}

